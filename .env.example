APP_NAME=Iranian LPR FastAPI
HOST=0.0.0.0
PORT=8000

# Local models only. This project never downloads a model.
PLATE_DETECTOR_WEIGHTS=weights/plate_detector.pt
PLATE_RECOGNIZER_DIR=weights/plate_recognizer

# Use cpu for CPU inference, or 0 for the first CUDA GPU.
LPR_DEVICE=0
LPR_USE_FP16=true

LPR_DETECTOR_IMGSZ=640
LPR_DETECTOR_CONFIDENCE=0.35
LPR_DETECTOR_IOU=0.45

# Set this only when your detector has multiple classes and none is named plate.
# Example: vehicle=0 and plate=1
LPR_PLATE_CLASS_IDS=

LPR_INPUT_DIR=input_images
LPR_OUTPUT_DIR=output

# preview=true always saves annotated files. This additionally opens OpenCV windows.
# Keep false on Docker/headless servers.
LPR_SHOW_WINDOW=false
LPR_OUTPUT_PERSIAN_DIGITS=false
LPR_MAX_RECENT_WATCH_RESULTS=200
